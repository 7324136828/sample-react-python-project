# Preferred ports. If either is busy, run.py advances until it finds a free one.
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Both services listen on the LAN by default. Use 127.0.0.1 for local-only access.
BACKEND_HOST=0.0.0.0

# Optional override of the database file selected by settings.json.
# Relative paths resolve from the project root (or beside server.exe when packaged).
# COUNTER_DB_PATH=data/counter.db
